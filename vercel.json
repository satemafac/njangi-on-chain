{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["cdg1"],
  "crons": [
    {
      "path": "/api/cron/cycle-finalized",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/whatsapp-circle-events",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/walrus-renewal",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/attestation-expiry",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "src/pages/api/cron/cycle-finalized.ts": {
      "maxDuration": 60
    },
    "src/pages/api/cron/whatsapp-circle-events.ts": {
      "maxDuration": 60
    },
    "src/pages/api/cron/walrus-renewal.ts": {
      "maxDuration": 60
    },
    "src/pages/api/cron/attestation-expiry.ts": {
      "maxDuration": 60
    },
    "src/pages/api/zkLogin.ts": {
      "maxDuration": 60
    }
  }
}
