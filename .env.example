# Canonical environment template for the whole repo.
# Copy this file to `.env.local` in the repo root and fill in the values you need.

NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

NEXT_PUBLIC_TESTNET_RPC_URL=https://fullnode.testnet.sui.io:443
NEXT_PUBLIC_MAINNET_RPC_URL=https://fullnode.mainnet.sui.io:443
NEXT_PUBLIC_TESTNET_RPC_ALT=https://sui-testnet-endpoint.blockvision.org
NEXT_PUBLIC_MAINNET_RPC_ALT=https://sui-mainnet-endpoint.blockvision.org
NEXT_PUBLIC_TESTNET_GRAPHQL_URL=https://sui-testnet.mystenlabs.com/graphql
NEXT_PUBLIC_MAINNET_GRAPHQL_URL=https://sui-mainnet.mystenlabs.com/graphql

NEXT_PUBLIC_TESTNET_PACKAGE_ID=0xyour_testnet_package_id
NEXT_PUBLIC_MAINNET_PACKAGE_ID=0xyour_mainnet_package_id
NEXT_PUBLIC_TESTNET_WHATSAPP_PACKAGE_ID=0xyour_testnet_whatsapp_package_id
NEXT_PUBLIC_MAINNET_WHATSAPP_PACKAGE_ID=0xyour_mainnet_whatsapp_package_id
NEXT_PUBLIC_TESTNET_WHATSAPP_REGISTRY_ID=0xyour_testnet_whatsapp_registry_id
NEXT_PUBLIC_MAINNET_WHATSAPP_REGISTRY_ID=0xyour_mainnet_whatsapp_registry_id
# Phase 12: filled by scripts/bootstrap-package.mjs after a fresh publish.
# njangi_compliance::init mints the AttestorCap to the deployer; the
# bootstrap script captures its object id + the deployer address.
NEXT_PUBLIC_TESTNET_NJANGI_ATTESTOR_CAP_ID=0xyour_testnet_attestor_cap_id
NEXT_PUBLIC_MAINNET_NJANGI_ATTESTOR_CAP_ID=0xyour_mainnet_attestor_cap_id
# njangi_price_validator::init_registry creates a shared AssetRegistry.
# The bootstrap script captures the resulting object id.
NEXT_PUBLIC_TESTNET_NJANGI_ASSET_REGISTRY_ID=0xyour_testnet_asset_registry_id
NEXT_PUBLIC_MAINNET_NJANGI_ASSET_REGISTRY_ID=0xyour_mainnet_asset_registry_id
NEXT_PUBLIC_ENOKI_TESTNET=enoki_testnet_key
NEXT_PUBLIC_ENOKI_MAINNET=enoki_mainnet_key

NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
NEXT_PUBLIC_FACEBOOK_CLIENT_ID=your_facebook_client_id
NEXT_PUBLIC_APPLE_CLIENT_ID=your_apple_client_id
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/auth/callback
# Optional, standalone salt-service deployments only: comma-separated OAuth
# client IDs accepted as JWT audiences. Defaults to the NEXT_PUBLIC_*_CLIENT_ID
# values above when unset.
SALT_ALLOWED_AUDIENCES=

NEXT_PUBLIC_TESTNET_USDC=0xyour_testnet_usdc_type
NEXT_PUBLIC_MAINNET_USDC=0xyour_mainnet_usdc_type
NEXT_PUBLIC_MAINNET_SUI_USDE=0xyour_mainnet_sui_usde_type
NEXT_PUBLIC_MAINNET_EMBER_SUI_USDE_VAULT_ID=0xyour_ember_vault_id
NEXT_PUBLIC_MAINNET_EMBER_VAULT_PACKAGE=0xyour_ember_vault_package
NEXT_PUBLIC_MAINNET_EMBER_PROTOCOL_CONFIG=0xyour_ember_protocol_config
NEXT_PUBLIC_MAINNET_EMBER_ESUIUSDE_RECEIPT=0xyour_ember_receipt_coin_type

NEXT_PUBLIC_TESTNET_CETUS_PACKAGE=0xyour_testnet_cetus_package
NEXT_PUBLIC_TESTNET_CETUS_GLOBAL_CONFIG=0xyour_testnet_cetus_global_config
NEXT_PUBLIC_TESTNET_CETUS_POOL_SUI_USDC=0xyour_testnet_cetus_pool
NEXT_PUBLIC_MAINNET_CETUS_PACKAGE=0xyour_mainnet_cetus_package
NEXT_PUBLIC_MAINNET_CETUS_GLOBAL_CONFIG=0xyour_mainnet_cetus_global_config
NEXT_PUBLIC_MAINNET_CETUS_POOL_SUI_USDC=0xyour_mainnet_cetus_pool

WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token
WHATSAPP_APP_SECRET=your_whatsapp_app_secret
WHATSAPP_API_VERSION=v21.0
# The Meta webhook callback now points at the Next.js app itself — the
# standalone whatsapp-bot-backend on :3001 was folded into the app
# (see whatsapp-bot-backend/DEPRECATED.md).
WHATSAPP_WEBHOOK_URL=http://localhost:3000/api/whatsapp/webhook
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
# /api/cron/whatsapp-circle-events skips (cursor still advances) events
# older than this when draining circle-event notifications. Default 24h.
WHATSAPP_EVENTS_MAX_EVENT_AGE_MS=86400000

# Postgres connection string. Required in production (Vercel + Neon) — the
# app fails fast at boot rather than silently falling back to per-instance
# memory/SQLite. Neon URLs include `?sslmode=require`; TLS certificate
# verification is on by default in production. Legacy Heroku databases with
# self-signed chains need PGSSLMODE=no-verify.
DATABASE_URL=postgres://user:password@localhost:5432/njangi
# Optional override when the URL carries no sslmode: disable | no-verify | require
PGSSLMODE=
# Pool sizing for serverless instances (per-lambda pool, keep small).
PG_POOL_MAX=5

# zkLogin session persistence (Vercel serverless migration). Sessions —
# including ephemeral key material — are AES-256-GCM encrypted with this
# 32-byte key (hex or base64) before being written to the zklogin_sessions
# table. `npm run generate:secrets` fills it.
ZKLOGIN_SESSION_ENC_KEY=hex_or_base64_32_byte_key

# (Removed June 2026: BACKEND_AUTH_TOKEN, WHATSAPP_BACKEND_URL,
# CIRCLE_BACKEND_URL, ANALYTICS_URL, REDIS_URL, LOG_LEVEL, LOG_FILE,
# ENABLE_EVENT_LISTENER, ENABLE_MESSAGE_SENDER, ENABLE_ON_CHAIN_LOGGING —
# all belonged to the retired whatsapp-bot-backend HTTP service.)

COINBASE_ONRAMP_ALLOWED_ORIGINS=http://localhost:3000

# Walrus PII storage — Phase 1 compliance redesign moves WhatsApp routing
# data off chain. Generate WALRUS_PII_MASTER_KEY as 32 random bytes
# (e.g. `openssl rand -hex 32`) and WALRUS_LOOKUP_SALT as a separate random
# value. Both must be kept private and rotated on a documented cadence.
WALRUS_PII_MASTER_KEY=hex_or_base64_32_byte_master_key
WALRUS_LOOKUP_SALT=random_lookup_salt_for_phone_index
WALRUS_PUBLISHER_URL=
WALRUS_AGGREGATOR_URL=
WALRUS_STORAGE_EPOCHS=5

# Fiat on/off-ramp providers (Phase 1 partner-led compliance)
NEXT_PUBLIC_MOONPAY_API_KEY=pk_test_replace_me
MOONPAY_SECRET_KEY=sk_test_replace_me
MOONPAY_WEBHOOK_KEY=wk_test_replace_me
NEXT_PUBLIC_MOONPAY_ENABLED=false
NEXT_PUBLIC_TRANSAK_API_KEY=
TRANSAK_API_SECRET=
NEXT_PUBLIC_TRANSAK_ENABLED=false

# Phase 3 compliance attestation — HMAC salt for hashing provider case IDs
# before they are anchored on chain. Generate with `openssl rand -hex 32`;
# rotate whenever the attestor key rotates. The public AttestorCap object
# id must be set so the issuer service can reference it at call time.
COMPLIANCE_REF_HMAC_SALT=change_me_random_hex
NJANGI_ATTESTOR_CAP_ID=0xyour_attestor_cap_object_id
# Public feature flag + expected issuer address. Phase 6 enforces the
# compliance attestation as a pay/collect precondition when this flag is
# true. Leave blank or "false" for pilots in unregulated corridors.
NEXT_PUBLIC_COMPLIANCE_GATE_ENABLED=false
NEXT_PUBLIC_NJANGI_ATTESTATION_ISSUER=0xyour_attestor_signer_address

# Phase 6 WhatsApp "your turn" notifier: shared secret external indexers
# send in `x-internal-auth` when calling /api/whatsapp/notify/your-turn.
# Generate with `openssl rand -hex 32`; rotate whenever the cron creds rotate.
INTERNAL_NOTIFY_SECRET=change_me_random_hex

# Vercel cron auth (June 2026 serverless migration). When this is set on the
# Vercel project, Vercel attaches `Authorization: Bearer ${CRON_SECRET}` to
# every cron invocation; /api/cron/cycle-finalized rejects anything else.
# Generate with `openssl rand -hex 32` (npm run generate:secrets fills it).
CRON_SECRET=change_me_random_hex
# Cycle-finalized cron advances past (without notifying) events older than
# this — a fresh cursor must not blast "your turn" nudges for cycles
# collected long ago. Default 24h.
CYCLE_FINALIZED_MAX_EVENT_AGE_MS=86400000
# Optional display formatting for cycle-finalized nudge amounts (defaults: 9 / SUI).
COIN_DECIMALS=9
COIN_SYMBOL=SUI
# Optional override for the defining package id the cron's CycleFinalized
# event filter uses. Defaults to the network's original publish id from
# src/lib/circle-chain.ts (Sui event type tags use the DEFINING package id,
# not the latest upgrade id).
PACKAGE_ID=

# Phase 8 compliance attestor console: optional distinct secret for the
# /api/compliance/prepare-issuance endpoint. Falls back to
# INTERNAL_NOTIFY_SECRET when unset so a small pilot can share one secret
# between the notifier worker and the attestor console.
COMPLIANCE_ISSUANCE_SECRET=

# Sentry error tracking (June 2026 Vercel migration). OPTIONAL — every
# Sentry init is a hard no-op when these are empty. SENTRY_DSN covers the
# server/edge runtimes; NEXT_PUBLIC_SENTRY_DSN is the browser DSN (inlined
# into the client bundle — DSNs are write-only ingest keys, not secrets;
# point both at the same project unless you want separate ones).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional build-time source-map upload. Leave empty to skip uploads
# entirely (next.config.js disables sourcemap generation without the token).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Stripe subscription billing (June 2026). OPTIONAL until the public kill
# switch below is flipped — every billing endpoint degrades gracefully when
# these are unset. Server-only secrets, never NEXT_PUBLIC_*:
#   STRIPE_SECRET_KEY      — sk_test_*/sk_live_* API key (lazy client in
#                            src/services/stripe-service.ts).
#   STRIPE_WEBHOOK_SECRET  — whsec_* signing secret for
#                            /api/billing/webhook (raw-body verification).
#   STRIPE_PRICE_ID_PREMIUM — price_* id of the $9.99/mo premium plan.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID_PREMIUM=price_replace_me
# Public billing kill switch. While false (default) EVERYTHING stays free:
# checkout refuses to start and entitlement gates no-op. Flipping to true
# requires the three STRIPE_* values above (validate-env enforces this).
NEXT_PUBLIC_BILLING_ENABLED=false

# --- Ramp webhook authentication (2026-06 GTM audit hardening) ---
# Transak fails CLOSED: webhook events are rejected and the provider cannot
# be enabled (isTransakEnabled) unless TRANSAK_API_SECRET is set — flipping
# NEXT_PUBLIC_TRANSAK_ENABLED=true alone keeps Transak disabled.
# MoonPay webhooks verify Moonpay-Signature-V2 per MoonPay's docs:
# HMAC-SHA256 hex over "<t>.<raw body>" with MOONPAY_WEBHOOK_KEY, and
# deliveries outside a 5-minute timestamp window are rejected (anti-replay).
# Coinbase webhooks verify COINBASE_ONRAMP_WEBHOOK_SECRET over the raw
# request bytes (bodyParser disabled), so do not place a body-rewriting
# proxy in front of /api/onramp/coinbase/webhook.

# --- Geo-aware ramp routing (2026-06 GTM audit: CEMAC money-in) ---
# GET /api/onramp/geo reads Vercel's x-vercel-ip-country header to detect the
# user's country and reports authoritative provider availability (public flag
# AND server-side secrets) to the RampPicker. CEMAC users (CM/GA/TD/CF/CG/GQ)
# get Transak (XAF) first, then MoonPay; US users get Coinbase first; everyone
# else gets MoonPay, Transak, then Coinbase. Users can override their region
# in the picker (stored client-side in localStorage).
#
# TRANSAK_ENVIRONMENT pins the Transak hosted-widget host independently of the
# Sui network: STAGING -> https://global-stg.transak.com, PRODUCTION ->
# https://global.transak.com. Leave empty to follow the network (mainnet ->
# production, otherwise staging). Transak issues separate API keys per
# environment — keep NEXT_PUBLIC_TRANSAK_API_KEY/TRANSAK_API_SECRET in sync
# with this value.
TRANSAK_ENVIRONMENT=

# --- Legal surface (June 2026; docs/legal-drafts/ACCEPTANCE-GATE-SPEC.md) ---
# HMAC-SHA256 salt for hashing client IPs on legal-acceptance and
# data-deletion records (legal_acceptances.ip_hash / deletion_requests.ip_hash).
# Raw IPs are never stored. Generate with `npm run generate:secrets` (or any
# 32-byte random hex). Required in production before enabling the acceptance gate.
LEGAL_ACCEPT_IP_SALT=

# --- Coinbase Onramp credentials (2026-06 GTM audit: previously undocumented
# despite being hard-required by /api/onramp/coinbase/*) ---
# NEXT_PUBLIC_COINBASE_ONRAMP_ENABLED is the client-visible floor for the
# RampPicker; /api/onramp/geo only reports Coinbase as available when this
# flag is true AND both CDP keys are set (fail closed). Coinbase Onramp
# serves US users only — CEMAC routing prefers Transak/MoonPay regardless.
# CDP_API_KEY_ID / CDP_API_KEY_SECRET: Coinbase Developer Platform secret
# API key used server-side to mint session tokens (never sent to browser).
# COINBASE_ONRAMP_WEBHOOK_SECRET: HMAC secret for verifying webhook
# deliveries to /api/onramp/coinbase/webhook over the raw request bytes.
NEXT_PUBLIC_COINBASE_ONRAMP_ENABLED=false
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
COINBASE_ONRAMP_WEBHOOK_SECRET=
