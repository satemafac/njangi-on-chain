  "outro_cards": [
    {
      "eyebrow": "The answer was never new",
      "h": "A circle of people who trust each other.",
      "sub": "Everyone pays in. One takes the whole pot. It goes round. Njangi, tontine, susu: the same idea, for generations, with no bank between neighbours.",
      "dur": 3.6
    },
    {
      "eyebrow": "Njangi On-Chain",
      "h": "The same circle. <em style=\"font-style:normal;color:var(--gold)\">Across borders.</em>",
      "sub": "Contribute from Douala or Dallas. The pot goes straight to whoever's turn it is. No bank in Europe in between, no cut taken from the pot, and no function that lets us move a circle's money.",
      "dur": 8.0,
      "viz": "pot"
    },
    {
      "eyebrow": "Why it matters",
      "h": "Nobody holds the pot. <em style=\"font-style:normal;color:var(--gold)\">Not even us.</em>",
      "sub": "The poverty tax is what the middle charges. We built the circle without a middle.",
      "foot": "njangionchain.com/learn \u00b7 link in bio",
      "dur": 3.6
    },
    {
      "eyebrow": "Credit",
      "h": "Voice: Farida Nabourema",
      "sub": "Founder of the Africa Bitcoin Conference. Interviewed on Simply Bitcoin, episode 1583, from 46:00. The figures are hers, as stated. Full link in the comments.",
