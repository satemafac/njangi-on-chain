[package]
name = "njangi"
version = "0.1.0"
published-at = "0x0"
edition = "2024"

[dependencies]
Sui = { git = "https://github.com/MystenLabs/sui.git", subdir = "crates/sui-framework/packages/sui-framework", rev = "041c5f2bae2fe52079e44b70514333532d69f4e6" }
Pyth = { git = "https://github.com/pyth-network/pyth-crosschain.git", subdir = "target_chains/sui/contracts", rev = "sui-contract-mainnet" }
# Note: Wormhole is a dependency of Pyth, so we don't need to include it explicitly to avoid conflicts

# DYNAMIC NETWORK CONFIGURATION
# This file is dynamically updated by scripts/switch-network.sh
# Current configuration: MAINNET

# CETUS INTEGRATION - MAINNET DEPENDENCIES
# Using official mainnet package addresses (mainnet-v1.49.0) for production protocol integration
# Source: https://cetus-1.gitbook.io/cetus-developer-docs/developer/via-contract

[addresses]
njangi = "0x0"
# Official Cetus mainnet package addresses (mainnet-v1.49.0)
cetus_clmm = "0x75b2e9ecad34944b8d0c874e568c90db0cf9437f0d7392abfd4cb902972f3e40"
