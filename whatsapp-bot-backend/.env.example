# ============================================================
# WhatsApp Bot Backend - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values

# ============================================================
# SUI BLOCKCHAIN CONFIGURATION
# ============================================================

# Testnet RPC endpoint
SUI_TESTNET_RPC_URL=https://testnet-rpc.sui.io

# Mainnet RPC endpoint
SUI_MAINNET_RPC_URL=https://fullnode.mainnet.sui.io

# Alternate testnet RPC (for failover)
SUI_TESTNET_RPC_ALT=https://testnet-rpc-alt.sui.io

# Alternate mainnet RPC (for failover)
SUI_MAINNET_RPC_ALT=https://mainnet-rpc-alt.sui.io

# Testnet package ID where whatsapp_integration Move contract is deployed
SUI_TESTNET_PACKAGE_ID=0x...

# Mainnet package ID where whatsapp_integration Move contract is deployed
SUI_MAINNET_PACKAGE_ID=0x...

# Default package ID to use (testnet or mainnet)
SUI_DEFAULT_PACKAGE_ID=0x...

# WhatsAppLinksRegistry object ID on-chain
SUI_WHATSAPP_LINKS_REGISTRY_ID=0x...

# ============================================================
# WHATSAPP CLOUD API CONFIGURATION
# ============================================================

# WhatsApp Business Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# WhatsApp Cloud API access token (permanent)
WHATSAPP_ACCESS_TOKEN=your_access_token

# Webhook verification token (can be any string you choose)
WHATSAPP_VERIFY_TOKEN=your_verify_token

# WhatsApp App Secret
WHATSAPP_APP_SECRET=your_app_secret

# WhatsApp Cloud API version
WHATSAPP_API_VERSION=v21.0

# Webhook URL (where WhatsApp sends messages)
WHATSAPP_WEBHOOK_URL=http://localhost:3001/api/whatsapp/webhook

# WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id

# ============================================================
# ZKLOGIN (ENOKI) CONFIGURATION
# ============================================================

# Enoki API key for testnet
ZKLOGIN_TESTNET_ENOKI_KEY=your_testnet_enoki_key

# Enoki API key for mainnet
ZKLOGIN_MAINNET_ENOKI_KEY=your_mainnet_enoki_key

# Default Enoki key to use
ZKLOGIN_DEFAULT_ENOKI_KEY=your_default_enoki_key

# zkLogin issuer URL
ZKLOGIN_ISSUER_URL=https://accounts.google.com

# ============================================================
# OAUTH PROVIDERS (For zkLogin)
# ============================================================

# Google OAuth
ZKLOGIN_GOOGLE_CLIENT_ID=your_google_client_id
ZKLOGIN_GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook OAuth
ZKLOGIN_FACEBOOK_CLIENT_ID=your_facebook_client_id
ZKLOGIN_FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# Apple OAuth
ZKLOGIN_APPLE_CLIENT_ID=your_apple_client_id
ZKLOGIN_APPLE_CLIENT_SECRET=your_apple_client_secret

# OAuth redirect URL
ZKLOGIN_REDIRECT_URL=http://localhost:3000/api/auth/callback

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================

# Node environment
NODE_ENV=development

# Server port
PORT=3001

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Log file path
LOG_FILE=logs/app.log

# ============================================================
# FEATURE FLAGS
# ============================================================

# Enable event listener for blockchain events
ENABLE_EVENT_LISTENER=true

# Enable message sender for WhatsApp
ENABLE_MESSAGE_SENDER=true

# Enable on-chain logging
ENABLE_ON_CHAIN_LOGGING=true
